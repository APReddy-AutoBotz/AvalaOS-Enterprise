{
  "name": "avalaos-enterprise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --outDir dist-e2e",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "test:new": "node --test \"domain/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval": "node eval/run.ts",
    "test:secret-hygiene": "node scripts/check-secret-hygiene.mjs",
    "in-use": "node scripts/in-use.mjs",
    "test": "npm run typecheck && npm run typecheck:edge && npm run test:new"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "bpmn-js": "^18.0.0",
    "docx": "^9.5.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.8.2",
    "vite": "8.1.6"
  }
}
