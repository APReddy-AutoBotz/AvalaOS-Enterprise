{
  "name": "avalaos-enterprise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:new": "node --test \"domain/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval": "node eval/run.ts",
    "test:secret-hygiene": "node scripts/check-secret-hygiene.mjs",
    "test": "npm run typecheck && npm run typecheck:edge && npm run test:new"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@supabase/supabase-js": "^2.105.0",
    "dompurify": "^3.4.17",
    "js-yaml": "4.3.2",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.8.2",
    "vite": "8.1.6",
    "yaml": "^2.9.0"
  }
}
